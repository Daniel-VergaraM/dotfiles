{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "autoupdate": true,
  "snapshot": true,
  "server": {
    "port": 4096
  },
  "tools": {
    "bash": true,
    "write": true,
    "edit": true,
    "read": true
  },
  "permission": {
    "*": "allow"
  },
  "share": "manual",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "llama2": {
          "name": "Llama 2"
        },
        "mistral": {
          "name": "Mistral"
        },
        "neural-chat": {
          "name": "Neural Chat"
        }
      }
    }
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "notebooklm": {
      "type": "remote",
      "url": "https://mcp.notebooklm.google.com",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:NOTEBOOKLM_API_KEY}"
      }
    }
  }
}
